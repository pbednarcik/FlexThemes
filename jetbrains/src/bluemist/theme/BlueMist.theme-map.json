      "status": "designed"
    },
    "Island.borderWidth.compact": {
      "raw": 8,
      "vsValue": "panel clarity rule",
      "element": "Eight-pixel gap between panels",
      "status": "designed"
    },
    "MainToolbar.Dropdown.background": {
      "value": "vs:Environment|FileTabLastActiveGradientTop",
      "element": "Pills on the title row. A navy title row was tried and measured in Rider: Islands fills the title row with the window colour and ignores MainToolbar.background, but still applies the white text and switches the header icons to light variants, so everything vanished",
      "status": "ms-blue",
      "under": "$text-default"
    },
    "MainToolbar.Dropdown.hoverBackground": {
