{
  "extends": "../../common/theme/Common.theme-base.json",
  "name": "Blue Mist",
  "fileName": "BlueMist",
  "providerId": "blue-mist",
  "author": "Peter Bednarčík. Colours from Microsoft's Visual Studio Blue theme where marked ms-blue; structure from JetBrains' Islands Light theme (Apache-2.0)",
  "dark": false,
  "parentTheme": "Islands Light",
  "baseThemeFile": "platform/themes/islands/ManyIslandsLight.theme.json",
  "vsBase": "Blue",
  "snapshot": "Blue",
  "schemeMap": "BlueMist",
  "editorScheme": "Blue Mist",
  "sourceNote": "Blue Mist is inspired by the Visual Studio 2019/2022 **Blue** theme, on Rider's Islands layout. Rows marked **ms-blue** follow that theme's colours; Visual Studio 2026 no longer ships Blue. Rows marked **designed** fill gaps Blue does not cover. Blue's dark frame (5D6B99) and dark captions are left out: Rider's icons measure 1.06:1 on that frame, and Rider has no key for caption text. A row with a contrast figure is checked by the build: text at least 4.5:1 (WCAG 2.2), icons at least 3:1. Panel/header separation follows the Periwinkle Night clarity rules using this theme's own hue; those UI adjustments are marked designed, while the existing syntax palette is preserved.",
  "colors": {
    "layer-0-bg": {
      "value": "#A2B4E3",
      "element": "Window frame: title row, gaps between panels, tool window strips. A periwinkle-blue between Blue's light command bar (CCD5F0) and its dark frame (5D6B99): 0.1 used CCD5F0 and read too close to Lavender Mist; the dark frame cannot be used because Islands draws dark text and icons on it. 0.3 used 8A9FD9, where title-row text measured 6.4:1 but only APCA Lc 51 and read as hard to read; A2B4E3 gives Lc 61 (8.1:1) with white panels still standing out at 2.0:1",
      "status": "designed",
      "under": "$text-default"
    },
    "layer-0-bg-inline": {
      "value": "vs:Environment|CommandBarGradientBegin",
      "element": "Band on the frame: status bar, info bar. Blue's command bar colour; a band closer to the frame (A3B3E0) failed the build with the status bar's secondary text at 3.5:1",
      "status": "ms-blue",
      "under": "$text-default"
    },
    "main-window-bg-alt": {
      "value": "$layer-0-bg-inline",
      "element": "Alternate window background (Rider concept)",
      "status": "ms-blue"
    },
    "layer-0-border": {
      "value": "#879AC7",
      "element": "Pane boundary in this theme's own palette; clearer than the inherited low-contrast separator",
      "status": "designed"
    },
    "layer-0-border-inline": {
      "value": "#7C91CC",
      "element": "Inline borders on the frame",
      "status": "designed"
    },
    "layer-1-bg": {
      "value": "vs:Environment|ToolWindowBackground",
      "element": "Dialogs and settings",
      "status": "ms-blue"
    },
    "layer-1-bg-inline": {
      "value": "#FFFFFF",
      "element": "Input fields in dialogs",
      "status": "designed"
    },
    "layer-1-border": {
      "value": "#CCD3EC",
      "element": "Dialog borders",
      "status": "designed"
    },
    "layer-1-border-inline": {
      "value": "#E1E6F5",
      "element": "Separators in dialogs",
      "status": "designed"
    },
    "layer-2-bg": {
      "value": "#FFFFFF",
      "element": "Popups, menus, notifications",
      "status": "designed"
    },
    "layer-2-bg-inline": {
      "value": "vs:Environment|CommandBarMenuBackgroundGradientBegin",
      "element": "Inline areas in popups: Blue's menu fill",
      "status": "ms-blue"
    },
    "layer-2-border": {
      "value": "#CCD3EC",
      "element": "Popup border",
      "status": "designed"
    },
    "layer-2-border-inline": {
      "value": "#E1E6F5",
      "element": "Separators in popups",
      "status": "designed"
    },
    "popup-border-windows": {
      "value": "#B8C2E6",
      "element": "Outer popup border on Windows",
      "status": "designed"
    },
    "editor-bg": {
      "value": "#FFFFFF",
      "element": "Editor background. Blue sets none, so Visual Studio falls back to white",
      "status": "designed"
    },
    "editor-bg-inline": {
      "value": "vs:Environment|CommandBarMenuBackgroundGradientBegin",
      "element": "In-editor search field and floating toolbars",
      "status": "ms-blue"
    },
    "editor-border-alt": {
      "value": "#879AC7",
      "element": "Pane boundary in this theme's own palette; clearer than the inherited low-contrast separator",
      "status": "designed"
    },
    "tool-window-bg": {
      "value": "vs:Environment|ToolWindowBackground",
      "element": "Tool window body",
      "status": "ms-blue"
    },
    "tool-window-bg-alt": {
      "value": "$tool-window-bg",
      "element": "Alternate tool window background",
      "status": "ms-blue"
    },
    "tool-window-border": {
      "value": "#879AC7",
      "element": "Pane boundary in this theme's own palette; clearer than the inherited low-contrast separator",
      "status": "designed"
    },
    "text-default": {
      "value": "vs:TreeView|Background|fg",
      "element": "Primary text",
      "status": "ms-blue",
      "on": "$tool-window-bg"
    },
    "text-muted": {
      "value": "#4E5670",
      "element": "Secondary text: counts, paths, hints",
      "status": "designed",
      "on": "$tool-window-bg"
    },
    "text-secondary": {
      "value": "#4E5670",
